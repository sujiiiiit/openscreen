<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Ad-hoc builds have no Team ID; macOS refuses to map frameworks whose
         Team ID differs from the main binary unless library validation is off.
         Also lets the unsigned-by-us mac-addon / node-mac-permissions .node load. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- V8 JIT under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Camera capture (CameraTrack.mm / camera preview window). -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- Microphone capture (ScreenCaptureKit mic on macOS 15+). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
