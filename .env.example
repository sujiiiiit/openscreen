# =============================================================================
# macOS CODE SIGNING & NOTARIZATION (optional — required for distribution)
# =============================================================================
# Read only by `pnpm package:mac` (scripts/build-mac.mjs) and the electron-builder
# hooks in build-resources/. Copy to `.env` (gitignored) and fill in.
#
# Leave APPLE_SIGNING_IDENTITY empty (or "-") for an ad-hoc / unsigned build:
# the DMG runs locally, but Gatekeeper warns on other Macs and notarization is
# skipped.
#
# The identity must be a "Developer ID Application" certificate — "Apple
# Development" / "Apple Distribution" certs cannot be notarized for direct
# distribution. Check what is installed with:
#   security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY=""   # e.g. "Developer ID Application: Your Name (XXXXXXXXXX)"

# Notarization (Apple notary service). All three are required to notarize.
# APPLE_ID_PASSWORD is an app-specific password from
# https://appleid.apple.com/account/manage → Sign-In and Security →
# App-Specific Passwords. It is NOT your Apple ID login password.
APPLE_ID=""                 # e.g. "you@example.com"
APPLE_ID_PASSWORD=""        # e.g. "xxxx-xxxx-xxxx-xxxx"
APPLE_TEAM_ID=""            # 10-char team ID, e.g. "XXXXXXXXXX"

# CI / ephemeral machines only: a base64-encoded .p12 (or a file path) and its
# password. Skip both when the cert is already in the login keychain.
# CSC_LINK=""
# CSC_KEY_PASSWORD=""

# Set to "1" to sign with the identity but skip notarization (faster local QA).
OPENSCREEN_SKIP_NOTARIZE=""
