# dependencies
/node_modules
packages/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# native-addon build output (node-gyp writes to <pkg>/build/ — and any
# accidental repo-root build/ from running node-gyp at the top level)
/build
**/build

# electron
/dist-electron/
/release/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (.env holds Apple signing credentials — never commit)
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# upstream reference clone — copied into packages/timeline & packages/timeline-engine,
# kept locally for diffing against new upstream changes
/react-timeline-editor/

# graphify skill output/cache
graphify-out/

# fallow local cache (committed baselines live in fallow-baselines/)
.fallow/
